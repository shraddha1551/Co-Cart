{
  "name": "sync-cart-server",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.js",
  "engines": { "node": ">=20.10" },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:create-test": "node src/db/createTestDb.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:create-test",
    "test": "cross-env NODE_ENV=test jest --runInBand"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.0.0"
  }
}
